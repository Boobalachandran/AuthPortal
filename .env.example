# ═══════════════════════════════════════════════════════════════════════════════
# AuthPortal Environment Variables Template
# ═══════════════════════════════════════════════════════════════════════════════
# IMPORTANT: Copy this file to .env and replace all <REPLACE_WITH_*> placeholders
# .env is Git-ignored and never committed
# Never commit actual secrets or credentials
# ═══════════════════════════════════════════════════════════════════════════════

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
# Docker Compose: uses internal hostname 'postgres:5432'
# Host machine access: localhost:5433 (mapped via docker-compose.yml port 5433:5432)
DB_URL=jdbc:postgresql://postgres:5432/authportal
DB_USERNAME=postgres
DB_PASSWORD=<REPLACE_WITH_SECURE_POSTGRES_PASSWORD>

# ─── Redis ────────────────────────────────────────────────────────────────────
# Docker Compose: uses internal hostname 'redis:6379'
# Local cache for OTP codes with TTL
REDIS_HOST=redis
REDIS_PORT=6379

# ─── Kafka ────────────────────────────────────────────────────────────────────
# Docker Compose: uses internal listener 'kafka:9092' (internal communication)
# Exposed listener: localhost:9094 (only for debugging from host)
# NOTE: application.properties default (localhost:9094) is overridden here for containers
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ─── JWT (JSON Web Token) ─────────────────────────────────────────────────────
# Generate a strong random secret:
#   Linux/Mac: openssl rand -hex 32
#   Windows PowerShell: -join((1..64) | ForEach-Object {"{0:x}" -f (Get-Random -Maximum 16)})
# Expiration: milliseconds (300000 = 5 minutes)
JWT_SECRET=REDACTED_JWT_PLACEHOLDER
JWT_EXPIRATION=300000

# ─── Google OAuth2 ────────────────────────────────────────────────────────────
# Register OAuth2 app at: https://console.cloud.google.com/apis/credentials
# Create OAuth 2.0 Client ID (Web application)
# Authorized redirect URIs:
#   Local: http://localhost:8080/login/oauth2/code/google
#   GKE:  https://<your-gateway-external-ip>:443/login/oauth2/code/google (after deployment)
GOOGLE_CLIENT_ID=<REPLACE_WITH_YOUR_GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<REPLACE_WITH_YOUR_GOOGLE_CLIENT_SECRET>
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# ─── CORS Origins (Externalized configuration) ─────────────────────────────────
# Comma-separated list of allowed browser origins
# Frontend makes requests from this origin; CORS headers must allow it
# Local: http://localhost:3000
# GKE:   http://<frontend-loadbalancer-ip> or https://your-domain.com
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── OAuth Frontend Redirect (Externalized configuration) ──────────────────────
# After OAuth login, backend redirects browser to this URL with JWT in query params
# This must match the CORS-allowed origin for browser to receive response
# Local: http://localhost:3000
# GKE:   http://<frontend-loadbalancer-ip> or https://your-domain.com
APP_OAUTH_FRONTEND_REDIRECT_BASE_URL=http://localhost:3000

# ─── Gmail SMTP (for notifications) ────────────────────────────────────────────
# Gmail Account Setup:
#   1. Enable 2-Step Verification at https://myaccount.google.com/security
#   2. Generate App Password at https://myaccount.google.com/apppasswords
#   3. Select "Mail" and "Windows Computer" (or applicable device)
#   4. Copy the 16-character app password to MAIL_PASSWORD below
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=<REPLACE_WITH_YOUR_GMAIL_ADDRESS@gmail.com>
MAIL_FROM_ADDRESS=<REPLACE_WITH_YOUR_GMAIL_ADDRESS@gmail.com>
MAIL_PASSWORD=<REPLACE_WITH_16CHAR_GMAIL_APP_PASSWORD>

# ─── SQL Logging (Externalized configuration) ────────────────────────────────
# Enable SQL query logging in application logs (for debugging)
# Set to 'true' only during development; disable in production (performance impact)
SHOW_SQL=false

# ─── POSTGRES_PASSWORD (for docker-compose.yml postgres service) ────────────────
# This is separate from DB_PASSWORD above; used by postgres container initialization
# Both should have the same value for consistency
POSTGRES_PASSWORD=<REPLACE_WITH_SECURE_POSTGRES_PASSWORD>

